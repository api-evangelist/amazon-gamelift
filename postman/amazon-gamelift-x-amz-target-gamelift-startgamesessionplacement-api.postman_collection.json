              "raw": "{\n  \"PlacementId\": \"FL76\",\n  \"GameSessionQueueName\": \"arn:5SA1Cl:gamesessionqueue/Y4\",\n  \"MaximumPlayerSessionCount\": \"<integer>\",\n  \"GameProperties\": [\n    {\n      \"Key\": \"<string>\",\n      \"Value\": \"<string>\"\n    },\n    {\n      \"Key\": \"<string>\",\n      \"Value\": \"<string>\"\n    }\n  ],\n  \"GameSessionName\": \"<string>\",\n  \"PlayerLatencies\": [\n    {\n      \"PlayerId\": \"<string>\",\n      \"RegionIdentifier\": \"<string>\",\n      \"LatencyInMilliseconds\": \"<float>\"\n    },\n    {\n      \"PlayerId\": \"<string>\",\n      \"RegionIdentifier\": \"<string>\",\n      \"LatencyInMilliseconds\": \"<float>\"\n    }\n  ],\n  \"DesiredPlayerSessions\": [\n    {\n      \"PlayerId\": \"<string>\",\n      \"PlayerData\": \"<string>\"\n    },\n    {\n      \"PlayerId\": \"<string>\",\n      \"PlayerData\": \"<string>\"\n    }\n  ],\n  \"GameSessionData\": \"<string>\"\n}",
