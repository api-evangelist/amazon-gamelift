              "raw": "{\n  \"GameServerGroupName\": \"-g\",\n  \"GameServerId\": \"3333\",\n  \"GameServerData\": \"v?JZ=?!fHIJ\",\n  \"UtilizationStatus\": \"UTILIZED\",\n  \"HealthCheck\": \"HEALTHY\"\n}",
