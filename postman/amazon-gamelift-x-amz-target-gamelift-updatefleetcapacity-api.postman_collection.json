            "body": {
              "mode": "raw",
              "raw": "{\n  \"FleetId\": \"fleet-Tjf+\",\n  \"DesiredInstances\": \"<integer>\",\n  \"MinSize\": \"<integer>\",\n  \"MaxSize\": \"<integer>\",\n  \"Location\": \"BitmpKH\"\n}",
              "options": {
