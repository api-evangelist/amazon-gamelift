      "name": "#X-Amz-Target=GameLift.UpdateFleetCapacity",
      "item": [
        {
          "name": "Amazon GameLift Update Fleet Capacity",
          "id": "49b7f2c3-da1d-4dd0-9946-cdcd7dd0b0e7",
          "protocolProfileBehavior": {
            "disableBodyPruning": true
