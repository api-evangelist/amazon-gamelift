            "body": {
              "mode": "raw",
              "raw": "{\n  \"FleetId\": \"arn:3OpW{UTA:fleet/fleet-arPIg58y~p`\",\n  \"Actions\": [\n    \"AUTO_SCALING\"\n  ],\n  \"Location\": \"JbCCh9XH0Ys\"\n}",
              "options": {
