            "body": {
              "mode": "raw",
              "raw": "{\n  \"FleetId\": \"arn::DAE\\\":fleet/fleet-1-a8\",\n  \"Locations\": [\n    {\n      \"Location\": \"IZJvwCbU1\"\n    }\n  ]\n}",
              "options": {
